# Enables the new marketing site and routed application shell. Set to 0 for the legacy UI.
VITE_UI_V2_ENABLED=1

# Selects the default landing page. Options: "optimized", "original", or "podcast".
VITE_LANDING_VARIANT=optimized

# Required for production canonical URLs, absolute social images, robots sitemap discovery, and sitemap.xml.
# Example: https://your-final-domain.com
VITE_SITE_URL=

# Browser-facing API root.
VITE_API_BASE_URL=http://localhost:3005/api

# Clerk authentication. Enable Google and email/password in the Clerk application.
# When omitted, authentication remains disabled for local development.
VITE_CLERK_PUBLISHABLE_KEY=

# Sentry browser monitoring. Session text and media are masked by the SDK configuration.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
