{
  "name": "easy-edits",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-frontend.mjs",
    "generate:social-image": "node scripts/generate-social-image.mjs",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:ui": "vitest run",
    "test": "node --test server/src/**/*.test.cjs && python3 server/src/renderWorker/faceTrack_test.py",
    "preview": "vite preview",
    "server": "node server/server.cjs",
    "server:inngest": "INNGEST_DEV=1 USE_INNGEST=1 node server/server.cjs",
    "inngest": "inngest dev -u http://localhost:3005/api/inngest",
    "db:migrate": "node server/scripts/migrate.cjs",
    "billing:test-concurrency": "node server/scripts/test-billing-concurrency.cjs",
    "vision:test": "node server/scripts/test-vision.cjs",
    "render:local:auto": "AUTO_RENDER_LOCAL=1 npm run server:inngest",
    "render:job": "node server/src/renderWorker/runRenderJob.cjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:inngest\" \"npm run inngest\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.654.0",
    "@aws-sdk/s3-request-presigner": "^3.654.0",
    "@clerk/express": "^2.1.88",
    "@clerk/react": "^6.18.6",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/instrument-serif": "^5.2.8",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@remotion/captions": "^4.0.488",
    "@sentry/node": "^10.67.0",
    "@sentry/react": "^10.67.0",
    "@tanstack/react-query": "^5.101.2",
    "@unhead/react": "^3.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dodopayments": "^2.42.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.0",
    "inngest": "^4.11.0",
    "lucide-react": "^0.561.0",
    "motion": "^12.42.2",
    "multer": "^2.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "inngest-cli": "^1.34.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
