DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Clerk API authentication. Both keys are required to enforce sessions.
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Comma-separated browser origins allowed to send Clerk session tokens.
CLERK_AUTHORIZED_PARTIES="http://localhost:3000"
# Set to 1 in production so a missing key fails closed instead of exposing the API.
CLERK_AUTH_REQUIRED=0
CLERK_TELEMETRY_DISABLED=1

# Sentry server monitoring. Use the API DSN for the Express service and the
# render-worker DSN for the Cloud Run Job.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE=0.05

# Dodo Payments. Keep API and webhook keys server-side only.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_CREATOR_PRODUCT_ID=""
DODO_GROWTH_PRODUCT_ID=""
DODO_STUDIO_PRODUCT_ID=""
PUBLIC_APP_URL="http://localhost:3000"
# Set to 1 anywhere quotas must fail closed without Postgres. Production does this automatically.
BILLING_REQUIRE_DATABASE=0

# Support email delivery. The From address must use a domain verified with Resend.
BREVO_API_KEY=""
SUPPORT_RECEIVER_EMAIL=""
SUPPORT_FROM_EMAIL="PodToClips Support <support@podtoclips.com>"
INNGEST_DEV=1
USE_INNGEST=1
INNGEST_EVENT_KEY="local-dev"
INNGEST_SIGNING_KEY="local-dev"

# Local dev default: filesystem storage under server/storage.
OBJECT_STORAGE_PROVIDER=local

# Production object storage: set OBJECT_STORAGE_PROVIDER=r2 and fill these values.
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""

# Real transcription. Local fallback is used when TRANSCRIPTION_PROVIDER=local.
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY="" # gitleaks:allow, intentionally empty example value
ASSEMBLYAI_POLL_MS=3000
ASSEMBLYAI_MAX_POLL_ATTEMPTS=120

# Real AI. Gemini models are called through OpenRouter only.
AI_PROVIDER=openrouter
SOCIAL_PROVIDER=openrouter
VISUAL_PROVIDER=local
VISUAL_SCENE_SCAN_MAX_FRAMES=30
RENDER_PROVIDER=cloud_run
AUTO_RENDER_LOCAL=0
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL="http://localhost:3001"
OPENROUTER_APP_TITLE="Podcast Repurposing Engine"
OPENROUTER_TEXT_MODEL="google/gemini-3-flash-preview"
OPENROUTER_STRUCTURED_MODEL="google/gemini-3-flash-preview"
OPENROUTER_VISION_MODEL="google/gemini-3-flash-preview"
FFMPEG_PATH="ffmpeg"
FFMPEG_PRESET=medium
FFMPEG_CRF=18
FFMPEG_AUDIO_BITRATE=160k
DENSE_FACE_TRACKING=0
DENSE_FACE_TRACKING_FPS=4
DENSE_FACE_TRACKING_MAX_POINTS=96
DENSE_FACE_TRACKING_MAX_RENDER_POINTS=48
DENSE_FACE_TRACKING_MIN_CONFIDENCE=0.25
DENSE_FACE_TRACKING_REQUIRED=0
DENSE_FACE_MIN_SPEAKER_SEGMENT_SECONDS=0.65
DENSE_FACE_SPEAKER_MERGE_GAP_SECONDS=0.8
DENSE_FACE_MAPPED_TRACK_MIN_CONFIDENCE=0.35
DENSE_FACE_PROMINENT_MIN_WIDTH=0.075
DENSE_FACE_PROMINENT_MIN_HEIGHT=0.14
DENSE_FACE_PROMINENT_MIN_CONFIDENCE=0.72
DENSE_FACE_SUPPRESS_MIN_SECONDS=0.65
FACE_DETECTOR_YUNET_MODEL=server/models/face_detection_yunet_2023mar.onnx
FACE_DETECTOR_YUNET_SCORE_THRESHOLD=0.55
MEDIAPIPE_FACE_REFINEMENT=0
MEDIAPIPE_FACE_LANDMARKER_MODEL=server/models/face_landmarker.task
MEDIAPIPE_FACE_MAX_FACES=6
MEDIAPIPE_FACE_RECOVERY=1
MEDIAPIPE_FACE_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_FACE_PRESENCE_CONFIDENCE=0.5
MEDIAPIPE_FACE_TRACKING_CONFIDENCE=0.5
RENDER_QC_ENABLED=0
RENDER_QC_SAFE_CONTAIN_FALLBACK=0
RENDER_QC_STACKED_SPEAKER_FALLBACK=0
RENDER_STACKED_MIN_SAMPLES=3
RENDER_STACKED_MIN_FACE_DISTANCE=0.16
RENDER_STACKED_MIN_COVISIBLE_SAMPLES=3
RENDER_STACKED_MIN_COVISIBLE_RATIO=0.6
RENDER_QC_FPS=1
RENDER_QC_EDGE_MARGIN=0.045
RENDER_QC_MAX_NO_FACE_RATIO=0.08
RENDER_QC_MAX_EDGE_FACE_RATIO=0.05
PYTHON_PATH=python3
RENDER_BACKGROUND_BLUR=34
RENDER_BACKGROUND_DIM=0.18
CAPTION_FONT=Inter
CAPTION_DEVANAGARI_FONT=Noto Sans Devanagari
CAPTION_FONTS_DIR=/usr/share/fonts/truetype/noto
CAPTION_FONT_SIZE=74
CAPTION_MARGIN_L=80
CAPTION_MARGIN_R=80
CAPTION_MARGIN_V=180

# Reversible 2026 rendering and ingest upgrades. Set the global switch to 0 to
# restore legacy ASS captions, legacy visual fitting, and blocking URL imports.
EASYED_UPGRADES_ENABLED=1
CONTEXT_BOUNDARY_REFINEMENT_ENABLED=1
CONTEXT_BOUNDARY_MODEL_ENABLED=1
CONTEXT_BOUNDARY_BEFORE_SECONDS=12
CONTEXT_BOUNDARY_AFTER_SECONDS=18
CONTEXT_BOUNDARY_MIN_SECONDS=20
CONTEXT_BOUNDARY_MAX_SECONDS=58
CONTEXT_BOUNDARY_PAUSE_SECONDS=0.65
CONTEXT_BOUNDARY_PRE_ROLL_SECONDS=0.2
CONTEXT_BOUNDARY_POST_ROLL_SECONDS=0.35
MOMENT_DISCOVERY_WINDOW_SECONDS=40
MOMENT_DISCOVERY_STRIDE_SECONDS=25
MOMENT_DISCOVERY_MAX_WINDOWS=240
MOMENT_DISCOVERY_MIN_WORDS=12
MOMENT_MIN_ENGAGEMENT=0.70
MOMENT_MIN_VIRALITY=0.62
MOMENT_MIN_RETENTION=0.62
REMOTION_CAPTIONS_ENABLED=1
REMOTION_CAPTION_PAGE_MS=900
REMOTION_CAPTION_MAX_WORDS=5
REMOTION_CAPTION_MAX_CHARACTERS=36
REMOTION_CAPTION_MARGIN_V=200
REMOTION_CAPTION_BURNED_IN_MARGIN_V=360
REMOTION_CAPTION_FIXED_FONT_SIZE=74
REMOTION_CAPTION_CENTER_Y=1520
REMOTION_CAPTION_BURNED_IN_CENTER_Y=1310
REMOTION_CAPTION_OUTLINE=4
REMOTION_CAPTION_SHADOW=2
SOURCE_VISUAL_FIT_V2_ENABLED=1
SOURCE_VISUAL_FIT_MAX_WIDTH=996
SOURCE_VISUAL_FIT_MAX_HEIGHT=1760
ASYNC_URL_INGEST_ENABLED=1
URL_IMPORT_CACHE_ENABLED=1
YT_DLP_FAST_MODE_ENABLED=1
YT_DLP_CONCURRENT_FRAGMENTS=6
YT_DLP_RETRIES=3
YT_DLP_FRAGMENT_RETRIES=5
YT_DLP_SOCKET_TIMEOUT_SECONDS=20
YT_DLP_FAST_FORMAT="bestvideo[ext=mp4][height<=1080]+bestaudio[ext=m4a]/bestvideo[height<=1080]+bestaudio/best[ext=mp4][height<=1080][height>=720][acodec!=none]/best[height<=1080]/best"
VISUAL_MAX_FRAMES=24
VISUAL_TEXT_COVERAGE_SECONDS=1.5
VISUAL_CLASSIFICATION_BATCH_SIZE=6
VISUAL_SCENE_THRESHOLD=0.18
VISUAL_FALLBACK_FPS=0.2

# Video-link ingestion. Required for YouTube and other supported platform URLs.
YT_DLP_PATH="yt-dlp"
YT_DLP_COOKIES_PATH=""
YT_DLP_JS_RUNTIME=""
YT_DLP_FORMAT="best[ext=mp4]/bestaudio[ext=m4a]/best"
YT_DLP_MAX_FILESIZE="2G"
YT_DLP_TIMEOUT_MS=600000

# Cloud Run render dispatch. Leave blank to create R2 render job specs without dispatching.
CLOUD_RUN_RENDER_DISPATCH_URL=""
CLOUD_RUN_RENDER_DISPATCH_TOKEN=""
GOOGLE_CLOUD_PROJECT=""
CLOUD_RUN_LOCATION="asia-south1"
CLOUD_RUN_RENDER_JOB="easyedits-render-worker"
CLOUD_RUN_RENDER_TIMEOUT_SECONDS=1200
CLOUD_RUN_OPERATION_POLL_MS=5000
RENDER_FAN_OUT_LIMIT=8
VISUAL_FAN_OUT_LIMIT=4
SCENE_SCRIPT_FAN_OUT_LIMIT=4
RENDER_SOURCE_ACCESS_MODE=signed_url
RENDER_SOURCE_URL_TTL_SECONDS=3600
DIRECT_UPLOAD_URL_TTL_SECONDS=3600
